// Nexora: quem usa sudo (grupo wheel) procura e instala atualizações sem pedir senha
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.sysupdate1.check" ||
         action.id == "org.freedesktop.sysupdate1.update" ||
         action.id == "org.freedesktop.sysupdate1.vacuum") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
