#!/bin/bash
# nexora-install-engine — motor do instalador da Nexora Linux (corre como root, no live).
#
# Uso: nexora-install-engine <ficheiro.conf>      (a senha do utilizador chega pelo stdin, 1.ª linha)
#
# O .conf define: DISK FULLNAME USERNAME HOSTNAME TIMEZONE LOCALE KEYMAP XKBLAYOUT DESKTOP CONFIRM=yes
#   DESKTOP: flow (Nexora Flow, niri/Wayland) ou xfce
# Saída para o instalador gráfico, uma por linha:
#   STEP <n> <total> <texto>   |   PROGRESS <0-100>   |   LOG <texto>   |   ERROR <texto>   |   DONE
#
# Disco A/B (GPT, só UEFI) — as atualizações escrevem na partição que não está em uso:
#   1  1 GiB   nexora-esp       EFI (systemd-boot + um UKI por versão)
#   2  10 GiB  nexora_<versão>  sistema A (imagem squashfs, só de leitura)
#   3  10 GiB  _empty           sistema B (a próxima versão vem para aqui)
#   4  resto   nexora-data      /var: /home, /etc alterado, Flatpak, AUR, registos
set -euo pipefail
export LC_ALL=C PATH=/usr/bin:/usr/sbin

MEDIUM=${NEXORA_MEDIUM:-/run/live/medium}
T=/mnt/nexora-target
IMGMNT=/run/nexora-install/image
TOTAL=7
GUID_ESP=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
GUID_ROOT=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709     # root x86-64 (Discoverable Partitions)
GUID_VAR=4D21B016-B534-45C2-A9FB-5C16E091FD2D      # /var
ROOT_SIZE=10GiB

say()   { echo "$*"; }
step()  { say "STEP $1 $TOTAL $2"; }
prog()  { say "PROGRESS $1"; }
log()   { say "LOG $*"; }
fail()  { say "ERROR $*"; cleanup; exit 1; }
trap 'fail "failed at line $LINENO: $BASH_COMMAND"' ERR

cleanup() {
    trap - ERR
    for m in $T/sys/firmware/efi/efivars $T/dev/pts $T/dev $T/proc $T/sys $T/run $T/boot $T/etc $T/var $T $IMGMNT; do
        mountpoint -q "$m" 2>/dev/null && umount -l "$m" || true
    done
}

[ "$EUID" -eq 0 ] || { echo "ERROR must run as root"; exit 1; }
CONF=${1:?ficheiro de configuração em falta}
# shellcheck disable=SC1090
source "$CONF"
IFS= read -r PASSWORD || true

[ "${CONFIRM:-}" = yes ] || fail "missing CONFIRM=yes"
[ -b "$DISK" ] || fail "$DISK is not a disk"
[ -d /sys/firmware/efi ] || fail "this computer started in legacy BIOS mode; Nexora needs UEFI (turn off CSM/Legacy in the firmware settings)"
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "invalid username: $USERNAME"
[ -n "$PASSWORD" ] || fail "empty password"
[ -e "/usr/share/zoneinfo/$TIMEZONE" ] || fail "unknown time zone: $TIMEZONE"
SRCIMG=$(ls $MEDIUM/nexora/nexora_*.root.raw 2>/dev/null | tail -1)
[ -n "$SRCIMG" ] || fail "system image not found on the live medium"
VER=$(basename "$SRCIMG" .root.raw); VER=${VER#nexora_}
UKI=$MEDIUM/nexora/nexora_$VER.efi
[ -f "$UKI" ] || fail "boot image nexora_$VER.efi not found on the live medium"
[ "$(blockdev --getsize64 "$DISK")" -ge $((30 * 1000 ** 3)) ] || fail "$DISK is smaller than 30 GB"

# nunca instalar por cima do próprio live
LIVEDEV=$(findmnt -no SOURCE "$MEDIUM" 2>/dev/null || true)
if [ -n "$LIVEDEV" ]; then
    LIVEDISK=/dev/$(lsblk -no PKNAME "$LIVEDEV" 2>/dev/null | head -1)
    [ "$LIVEDISK" = /dev/ ] && LIVEDISK=$LIVEDEV
    [ "$DISK" != "$LIVEDISK" ] && [ "$DISK" != "$LIVEDEV" ] || fail "$DISK is the disk the live session booted from"
fi

part() { case "$DISK" in *nvme*|*mmcblk*|*loop*) echo "${DISK}p$1" ;; *) echo "${DISK}$1" ;; esac; }
P1=$(part 1); P2=$(part 2); P3=$(part 3); P4=$(part 4)

# ---------------------------------------------------------------- 1. partições
step 1 "Preparing disk $DISK"
prog 2
cleanup
for p in $(lsblk -lnpo NAME "$DISK" | tail -n +2); do umount -l "$p" 2>/dev/null || true; swapoff "$p" 2>/dev/null || true; done
wipefs -af "$DISK" >/dev/null
sfdisk -q --wipe always "$DISK" << EOF
label: gpt
size=1GiB, type=$GUID_ESP, name="nexora-esp"
size=$ROOT_SIZE, type=$GUID_ROOT, name="nexora_$VER"
size=$ROOT_SIZE, type=$GUID_ROOT, name="_empty"
type=$GUID_VAR, name="nexora-data"
EOF
partx -u "$DISK" 2>/dev/null || true
udevadm settle 2>/dev/null || true
for i in $(seq 50); do [ -b "$P4" ] && break; sleep 0.2; done
[ -b "$P4" ] || fail "the new partitions did not show up"
log "partitions: EFI $P1, system A $P2 (nexora_$VER), system B $P3, data $P4"
prog 4

# ---------------------------------------------------------------- 2. sistemas de ficheiros
step 2 "Formatting"
mkfs.vfat -F 32 -n NEXORA_ESP "$P1" >/dev/null
mkfs.ext4 -F -q -L nexora-data "$P4"
prog 6

# ---------------------------------------------------------------- 3. imagem do sistema
step 3 "Copying Nexora $VER to disk"
SIZE=$(stat -c %s "$SRCIMG")
dd if="$SRCIMG" of="$P2" bs=4M conv=fsync status=progress 2>&1 |
    tr '\r' '\n' | while read -r line; do
        if [[ "$line" =~ ^([0-9]+)\ bytes ]]; then
            echo "PROGRESS $(( 6 + ${BASH_REMATCH[1]} * 64 / SIZE ))"
        fi
    done
[ "${PIPESTATUS[0]}" -eq 0 ] || fail "copying the system image failed"
log "system image written to $P2"
prog 70

# ---------------------------------------------------------------- 4. montar como no arranque
step 4 "Preparing your data partition"
mkdir -p $T $IMGMNT
mount -t squashfs -o ro "$P2" $T
mount "$P4" $T/var
# o /var da imagem é o ponto de partida da partição de dados
mount -t squashfs -o ro "$P2" $IMGMNT
cp -a $IMGMNT/var/. $T/var/
umount $IMGMNT
V=$T/var
mkdir -p $V/lib/nexora/etc/upper $V/lib/nexora/etc/work $V/home $V/roothome $V/usrlocal $V/srv
chmod 700 $V/roothome
echo "$VER" > $V/lib/nexora/var-version
mount -t overlay overlay -o lowerdir=$T/etc,upperdir=$V/lib/nexora/etc/upper,workdir=$V/lib/nexora/etc/work $T/etc
mount "$P1" $T/boot
mount --bind /dev $T/dev
mount --bind /dev/pts $T/dev/pts
mount -t proc proc $T/proc
mount -t sysfs sysfs $T/sys
mount -t tmpfs tmpfs $T/run
mount -t efivarfs efivarfs $T/sys/firmware/efi/efivars 2>/dev/null || true
in_t() { chroot $T /usr/bin/env -i PATH=/usr/bin:/usr/sbin HOME=/root LC_ALL=C "$@"; }
prog 78

# ---------------------------------------------------------------- 5. configurar
step 5 "Configuring the system"
in_t systemd-machine-id-setup >/dev/null
ESP_UUID=$(blkid -s UUID -o value "$P1")
echo "UUID=$ESP_UUID  /boot  vfat  umask=0077,noatime  0 2" >> $T/etc/fstab
echo "$HOSTNAME" > $T/etc/hostname
cat > $T/etc/hosts << EOF
127.0.0.1 localhost
127.0.1.1 $HOSTNAME.localdomain $HOSTNAME
::1       localhost ip6-localhost ip6-loopback
EOF
ln -sfn "/usr/share/zoneinfo/$TIMEZONE" $T/etc/localtime
echo "LANG=$LOCALE" > $T/etc/locale.conf
printf 'KEYMAP=%s\nFONT=Lat2-Terminus16\n' "$KEYMAP" > $T/etc/vconsole.conf
mkdir -p $T/etc/X11/xorg.conf.d
cat > $T/etc/X11/xorg.conf.d/00-keyboard.conf << EOF
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "$XKBLAYOUT"
EndSection
EOF

# ambiente de trabalho por omissão no ecrã de login
mkdir -p $T/etc/lightdm/lightdm.conf.d
case "${DESKTOP:-flow}" in
    xfce) SESSION=xfce ;;
    *)    SESSION=niri ;;
esac
printf '[Seat:*]\nuser-session=%s\n' "$SESSION" > $T/etc/lightdm/lightdm.conf.d/50-nexora-session.conf
# o teclado do Nexora Flow (o niri não lê o xorg.conf.d)
[ -f $T/etc/niri/config.kdl ] && sed -i "s/^\( *layout\) \"[a-z]*\"/\1 \"$XKBLAYOUT\"/" $T/etc/niri/config.kdl
log "default session: $SESSION"

# utilizador (a pasta pessoal fica em /var/home, na partição de dados)
in_t groupadd -f autologin
in_t useradd -m -c "$FULLNAME" -G wheel,video,audio,input,users,lpadmin -s /bin/bash "$USERNAME"
printf '%s:%s\n' "$USERNAME" "$PASSWORD" | in_t chpasswd
in_t usermod -p "*" root           # root sem senha (não entra com senha); administra-se com sudo
log "user $USERNAME created"
rm -rf $T/var/lib/lightdm/.cache/lightdm-gtk-greeter $T/var/cache/lightdm/dmrc/*
printf '[Desktop]\nSession=%s\n' "$SESSION" > $T/home/$USERNAME/.dmrc
in_t chown "$USERNAME:" /home/$USERNAME/.dmrc
mkdir -p $T/var/cache/lightdm/dmrc
cp $T/home/$USERNAME/.dmrc $T/var/cache/lightdm/dmrc/$USERNAME.dmrc
prog 88

# ---------------------------------------------------------------- 6. arranque
step 6 "Installing the boot loader"
if in_t bootctl install --esp-path=/boot >/dev/null 2>&1; then
    log "systemd-boot installed (Nexora entry in the firmware)"
else
    in_t bootctl install --esp-path=/boot --no-variables >/dev/null
    log "systemd-boot installed (no firmware entry; the disk boots as a removable drive)"
fi
printf 'timeout 3\nconsole-mode keep\n' > $T/boot/loader/loader.conf
install -Dm644 "$UKI" "$T/boot/EFI/Linux/nexora_$VER.efi"
log "boot image nexora_$VER.efi installed"
prog 96

# ---------------------------------------------------------------- 7. fim
step 7 "Finishing"
sync
cleanup
prog 100
say DONE
