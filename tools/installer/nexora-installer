#!/usr/bin/env python3
"""Instalador gráfico da Nexora Linux (GTK3).

Recolhe as escolhas (região, teclado, disco, utilizador) e corre o nexora-install-engine
como root, mostrando o progresso. Pensado para a sessão live (utilizador nexora com sudo).
"""
import json
import os
import re
import subprocess
import tempfile
import threading

import locale

# o instalador é em inglês (os botões do GTK também), seja qual for o idioma do live
os.environ["LANGUAGE"] = "en_US:en"
for _loc in ("en_US.UTF-8", "en_US.utf8", "C.UTF-8"):
    try:
        locale.setlocale(locale.LC_ALL, _loc)
        break
    except locale.Error:
        pass

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Pango  # noqa: E402

ENGINE = "/usr/sbin/nexora-install-engine"
LOGO = "/usr/share/icons/hicolor/scalable/apps/nexora.svg"

KEYMAPS = [  # (nome, KEYMAP da consola, layout X)
    ("Portuguese (Portugal)", "pt-latin1", "pt"),
    ("Portuguese (Brazil)", "br-abnt2", "br"),
    ("English (US)", "us", "us"),
    ("English (UK)", "uk", "gb"),
    ("Spanish", "es", "es"),
    ("French", "fr-latin1", "fr"),
    ("German", "de-latin1", "de"),
]
DESKTOPS = [  # (nome, valor para o motor)
    ("Nexora Flow (Wayland) — scrolling windows, the Nexora desktop", "flow"),
    ("Xfce (classic) — top bar and dock, like the live session", "xfce"),
]
LOCALES = [
    ("English", "en_US.UTF-8"),
    ("Portuguese (Portugal)", "pt_PT.UTF-8"),
    ("Portuguese (Brazil)", "pt_BR.UTF-8"),
    ("Spanish", "es_ES.UTF-8"),
    ("French", "fr_FR.UTF-8"),
    ("German", "de_DE.UTF-8"),
]

CSS = b"""
.nx-title { font-size: 20pt; font-weight: 300; }
.nx-big { font-size: 13pt; }
.nx-warn { color: #e5534b; font-weight: 600; }
.nx-dim { opacity: 0.7; }
"""


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000
    return f"{n:.1f} PB"


def list_disks():
    """Discos onde se pode instalar (sem o próprio live, loops, CD, zram)."""
    try:
        out = subprocess.run(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,SIZE,MODEL,TYPE,TRAN,RO"],
                             capture_output=True, text=True, check=True).stdout
        disks = json.loads(out)["blockdevices"]
    except Exception:
        return []
    live = ""
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/run/live/medium"], capture_output=True,
                             text=True).stdout.strip()
        if src:
            pk = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True, text=True).stdout.split()
            live = "/dev/" + pk[0] if pk and pk[0] else src
    except Exception:
        pass
    res = []
    for d in disks:
        if d.get("type") != "disk" or d.get("ro") in (True, "1", 1):
            continue
        if re.match(r"^(loop|sr|zram|ram|fd)", d["name"]) or d["path"] == live:
            continue
        if int(d.get("size") or 0) < 30 * 10**9:   # A/B: EFI + 2 × 10 GB + dados
            continue
        res.append(d)
    return res


def zones():
    out = []
    try:
        with open("/usr/share/zoneinfo/zone1970.tab") as f:
            for line in f:
                if line.startswith("#"):
                    continue
                parts = line.split("\t")
                if len(parts) >= 3:
                    out.append(parts[2].strip())
    except Exception:
        out = ["Europe/Lisbon", "UTC"]
    return sorted(set(out + ["UTC"]))


class Installer(Gtk.Assistant):
    def __init__(self):
        super().__init__(title="Install Nexora Linux")
        self.set_default_size(820, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        if os.path.exists(LOGO):
            self.set_icon_from_file(LOGO)
        self.connect("cancel", self.on_cancel)
        self.connect("close", lambda *_: Gtk.main_quit())
        self.connect("prepare", self.on_prepare)
        self.connect("apply", self.on_apply)
        self.installing = False
        self.done = False

        self.page_intro()
        self.page_region()
        self.page_disk()
        self.page_user()
        self.page_summary()
        self.page_progress()
        self.page_finish()

    # ------------------------------------------------------------ páginas
    def box(self):
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        b.set_border_width(28)
        return b

    def add(self, widget, title, ptype=Gtk.AssistantPageType.CONTENT, complete=True):
        self.append_page(widget)
        self.set_page_title(widget, title)
        self.set_page_type(widget, ptype)
        self.set_page_complete(widget, complete)
        return widget

    def label(self, text, cls=None, wrap=True, xalign=0.0, markup=False):
        lb = Gtk.Label()
        lb.set_markup(text) if markup else lb.set_text(text)
        lb.set_line_wrap(wrap)
        lb.set_xalign(xalign)
        if cls:
            lb.get_style_context().add_class(cls)
        return lb

    def page_intro(self):
        b = self.box()
        b.set_valign(Gtk.Align.CENTER)
        if os.path.exists(LOGO):
            img = Gtk.Image.new_from_pixbuf(
                __import__("gi.repository.GdkPixbuf", fromlist=["GdkPixbuf"]).Pixbuf.new_from_file_at_size(LOGO, 112, 112))
            b.pack_start(img, False, False, 0)
        b.pack_start(self.label("Welcome to Nexora Linux", "nx-title", xalign=0.5), False, False, 0)
        b.pack_start(self.label(
            "This assistant installs Nexora on your computer. You will pick your desktop, region and "
            "keyboard, the disk and your user account. It only takes a few minutes.", "nx-big", xalign=0.5), False, False, 0)
        b.pack_start(self.label("Warning: the disk you choose will be completely erased.",
                                "nx-warn", xalign=0.5), False, False, 0)
        self.add(b, "Welcome", Gtk.AssistantPageType.INTRO)

    def combo(self, items, active=0):
        c = Gtk.ComboBoxText()
        for it in items:
            c.append_text(it)
        c.set_active(active)
        return c

    def page_region(self):
        b = self.box()
        b.pack_start(self.label("Desktop, region and keyboard", "nx-title"), False, False, 0)
        g = Gtk.Grid(column_spacing=16, row_spacing=12)
        self.zone_list = zones()
        self.c_zone = self.combo(self.zone_list,
                                 self.zone_list.index("Europe/Lisbon") if "Europe/Lisbon" in self.zone_list else 0)
        self.c_kbd = self.combo([k[0] for k in KEYMAPS], 0)
        self.c_loc = self.combo([l[0] for l in LOCALES], 0)
        self.c_desk = self.combo([d[0] for d in DESKTOPS], 0)
        for i, (name, w) in enumerate((("Desktop", self.c_desk), ("Time zone", self.c_zone),
                                       ("Keyboard", self.c_kbd), ("System language", self.c_loc))):
            g.attach(self.label(name), 0, i, 1, 1)
            w.set_hexpand(True)
            g.attach(w, 1, i, 1, 1)
        b.pack_start(g, False, False, 0)
        test = Gtk.Entry(placeholder_text="Type here to test the keyboard (uses the current layout)")
        b.pack_start(test, False, False, 0)
        self.add(b, "Region")

    def page_disk(self):
        b = self.box()
        b.pack_start(self.label("Where to install?", "nx-title"), False, False, 0)
        b.pack_start(self.label("Pick a disk. Everything on it will be erased.", "nx-warn"), False, False, 0)
        self.disk_store = Gtk.ListStore(str, str, str, str)  # path, modelo, tamanho, ligação
        tv = Gtk.TreeView(model=self.disk_store)
        for i, t in enumerate(("Disk", "Model", "Size", "Bus")):
            r = Gtk.CellRendererText()
            if i == 1:
                r.set_property("ellipsize", Pango.EllipsizeMode.END)
            col = Gtk.TreeViewColumn(t, r, text=i)
            col.set_expand(i == 1)
            tv.append_column(col)
        tv.get_selection().connect("changed", self.on_disk_changed)
        self.disk_tv = tv
        sw = Gtk.ScrolledWindow()
        sw.set_vexpand(True)
        sw.add(tv)
        b.pack_start(sw, True, True, 0)
        self.disk_note = self.label("", "nx-dim")
        b.pack_start(self.disk_note, False, False, 0)
        rb = Gtk.Button(label="Refresh")
        rb.connect("clicked", lambda *_: self.fill_disks())
        rb.set_halign(Gtk.Align.START)
        b.pack_start(rb, False, False, 0)
        self.p_disk = self.add(b, "Disk", complete=False)
        self.fill_disks()

    def fill_disks(self):
        self.disk_store.clear()
        for d in list_disks():
            self.disk_store.append([d["path"], (d.get("model") or "").strip() or "—",
                                    human(int(d["size"])), (d.get("tran") or "").upper()])
        self.disk_note.set_text("" if len(self.disk_store) else
                                "No disk with at least 30 GB found (besides the live medium).")
        self.set_page_complete(self.p_disk, False)

    def on_disk_changed(self, sel):
        model, it = sel.get_selected()
        self.disk = model[it][0] if it else None
        self.disk_desc = f"{model[it][0]} — {model[it][1]} ({model[it][2]})" if it else ""
        self.set_page_complete(self.p_disk, bool(self.disk))

    def page_user(self):
        b = self.box()
        b.pack_start(self.label("Your account", "nx-title"), False, False, 0)
        g = Gtk.Grid(column_spacing=16, row_spacing=12)
        self.e_name = Gtk.Entry(placeholder_text="e.g. Alex Silva")
        self.e_user = Gtk.Entry(placeholder_text="e.g. alex")
        self.e_host = Gtk.Entry(text="nexora")
        self.e_pw1 = Gtk.Entry(visibility=False, input_purpose=Gtk.InputPurpose.PASSWORD)
        self.e_pw2 = Gtk.Entry(visibility=False, input_purpose=Gtk.InputPurpose.PASSWORD)
        rows = (("Full name", self.e_name), ("Username", self.e_user), ("Computer name", self.e_host),
                ("Password", self.e_pw1), ("Confirm password", self.e_pw2))
        for i, (n, w) in enumerate(rows):
            g.attach(self.label(n), 0, i, 1, 1)
            w.set_hexpand(True)
            g.attach(w, 1, i, 1, 1)
            w.connect("changed", self.validate_user)
        self.e_name.connect("changed", self.suggest_user)
        b.pack_start(g, False, False, 0)
        self.user_msg = self.label("", "nx-warn")
        b.pack_start(self.user_msg, False, False, 0)
        b.pack_start(self.label("Your account gets administrator rights (sudo). "
                                "The root account is locked.", "nx-dim"), False, False, 0)
        self.p_user = self.add(b, "Account", complete=False)
        self.user_touched = False
        self.e_user.connect("key-press-event", lambda *_: setattr(self, "user_touched", True))

    def suggest_user(self, *_):
        if self.user_touched:
            return
        first = (self.e_name.get_text().strip().split() or [""])[0].lower()
        first = (first.replace("ç", "c").replace("ã", "a").replace("á", "a").replace("é", "e")
                 .replace("í", "i").replace("ó", "o").replace("õ", "o").replace("ú", "u").replace("â", "a")
                 .replace("ê", "e").replace("ô", "o"))
        self.e_user.set_text(re.sub(r"[^a-z0-9_-]", "", first)[:32])

    def validate_user(self, *_):
        u, h = self.e_user.get_text(), self.e_host.get_text()
        p1, p2 = self.e_pw1.get_text(), self.e_pw2.get_text()
        msg = ""
        if not self.e_name.get_text().strip():
            msg = "Enter your name."
        elif not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", u):
            msg = "The username may only contain lowercase letters, digits, - and _ (and must start with a letter)."
        elif u in ("root", "nexora", "bin", "daemon", "nobody"):
            msg = f"The name '{u}' is reserved."
        elif not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,62}", h):
            msg = "The computer name may only contain letters, digits and -."
        elif len(p1) < 4:
            msg = "The password must be at least 4 characters."
        elif p1 != p2:
            msg = "The passwords do not match."
        self.user_msg.set_text(msg)
        self.set_page_complete(self.p_user, not msg)

    def page_summary(self):
        b = self.box()
        b.pack_start(self.label("Ready to install", "nx-title"), False, False, 0)
        self.summary = self.label("", "nx-big", markup=True)
        b.pack_start(self.summary, False, False, 0)
        b.pack_start(self.label("Clicking Install erases the chosen disk. This cannot be undone.",
                                "nx-warn"), False, False, 0)
        self.p_summary = self.add(b, "Summary", Gtk.AssistantPageType.CONFIRM)

    def page_progress(self):
        b = self.box()
        b.pack_start(self.label("Installing Nexora…", "nx-title"), False, False, 0)
        self.p_step = self.label("Starting…", "nx-big")
        b.pack_start(self.p_step, False, False, 0)
        self.bar = Gtk.ProgressBar(show_text=True)
        b.pack_start(self.bar, False, False, 0)
        exp = Gtk.Expander(label="Details")
        self.logview = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        sw = Gtk.ScrolledWindow(min_content_height=200)
        sw.add(self.logview)
        exp.add(sw)
        b.pack_start(exp, True, True, 0)
        self.p_progress = self.add(b, "Installing", Gtk.AssistantPageType.PROGRESS, complete=False)

    def page_finish(self):
        b = self.box()
        b.set_valign(Gtk.Align.CENTER)
        self.fin_title = self.label("Nexora is installed! 🎉", "nx-title", xalign=0.5)
        self.fin_text = self.label("Remove the USB stick or DVD and restart to enter your new system.",
                                   "nx-big", xalign=0.5)
        b.pack_start(self.fin_title, False, False, 0)
        b.pack_start(self.fin_text, False, False, 0)
        self.btn_reboot = Gtk.Button(label="Restart now")
        self.btn_reboot.get_style_context().add_class("suggested-action")
        self.btn_reboot.set_halign(Gtk.Align.CENTER)
        self.btn_reboot.connect("clicked", lambda *_: subprocess.Popen(["systemctl", "reboot"]))
        b.pack_start(self.btn_reboot, False, False, 0)
        self.p_finish = self.add(b, "Done", Gtk.AssistantPageType.SUMMARY)

    # ------------------------------------------------------------ lógica
    def choices(self):
        k = KEYMAPS[self.c_kbd.get_active()]
        lo = LOCALES[self.c_loc.get_active()]
        return dict(DISK=self.disk, FULLNAME=self.e_name.get_text().strip(), USERNAME=self.e_user.get_text(),
                    HOSTNAME=self.e_host.get_text(), TIMEZONE=self.c_zone.get_active_text(),
                    LOCALE=lo[1], KEYMAP=k[1], XKBLAYOUT=k[2], _kbd=k[0], _loc=lo[0],
                    DESKTOP=DESKTOPS[self.c_desk.get_active()][1], _desk=DESKTOPS[self.c_desk.get_active()][0])

    def on_prepare(self, _a, page):
        if page is self.p_summary:
            c = self.choices()
            esc = GLib.markup_escape_text
            self.summary.set_markup(
                f"<b>Disk:</b> {esc(self.disk_desc)}\n"
                f"<b>User:</b> {esc(c['FULLNAME'])} ({esc(c['USERNAME'])})\n"
                f"<b>Computer:</b> {esc(c['HOSTNAME'])}\n"
                f"<b>Desktop:</b> {esc(c['_desk'].split(' — ')[0])}\n"
                f"<b>Time zone:</b> {esc(c['TIMEZONE'])}\n"
                f"<b>Keyboard:</b> {esc(c['_kbd'])}   <b>Language:</b> {esc(c['_loc'])}")
            # o botão de confirmar passa a dizer "Install"
            GLib.idle_add(self.relabel_apply)

    def relabel_apply(self):
        def walk(w):
            if isinstance(w, Gtk.Button) and w.get_label() in ("_Apply", "Apply", "_Aplicar", "Aplicar"):
                w.set_label("Install")
                w.get_style_context().add_class("destructive-action")
            if isinstance(w, Gtk.Container):
                for ch in w.get_children():
                    walk(ch)
        walk(self)
        return False

    def on_apply(self, _a):
        c = self.choices()
        fd, conf = tempfile.mkstemp(prefix="nexora-install-", suffix=".conf")
        with os.fdopen(fd, "w") as f:
            for k in ("DISK", "FULLNAME", "USERNAME", "HOSTNAME", "TIMEZONE", "LOCALE", "KEYMAP", "XKBLAYOUT", "DESKTOP"):
                f.write(f"{k}={GLib.shell_quote(c[k])}\n")
            f.write("CONFIRM=yes\n")
        os.chmod(conf, 0o644)
        cmd = [ENGINE, conf] if os.geteuid() == 0 else ["sudo", "-n", ENGINE, conf]
        if os.geteuid() != 0 and subprocess.run(["sudo", "-n", "true"]).returncode != 0:
            cmd = ["pkexec", ENGINE, conf]
        self.installing = True
        threading.Thread(target=self.run_engine, args=(cmd, self.e_pw1.get_text(), conf), daemon=True).start()

    def run_engine(self, cmd, password, conf):
        ok, last_err = False, ""
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                 text=True, bufsize=1)
            p.stdin.write(password + "\n")
            p.stdin.close()
            for line in p.stdout:
                line = line.rstrip("\n")
                if line == "DONE":
                    ok = True
                elif line.startswith("ERROR "):
                    last_err = line[6:]
                GLib.idle_add(self.engine_line, line)
            p.wait()
            ok = ok and p.returncode == 0
        except Exception as e:  # noqa: BLE001
            last_err = str(e)
        finally:
            try:
                os.unlink(conf)
            except OSError:
                pass
        GLib.idle_add(self.engine_done, ok, last_err)

    def engine_line(self, line):
        buf = self.logview.get_buffer()
        if line.startswith("PROGRESS "):
            try:
                v = int(line.split()[1]) / 100
                self.bar.set_fraction(v)
                self.bar.set_text(f"{int(v * 100)}%")
            except ValueError:
                pass
            return False
        if line.startswith("STEP "):
            parts = line.split(" ", 3)
            if len(parts) == 4:
                self.p_step.set_text(f"Step {parts[1]} of {parts[2]}: {parts[3]}")
        buf.insert(buf.get_end_iter(), line + "\n")
        self.logview.scroll_to_iter(buf.get_end_iter(), 0, False, 0, 0)
        return False

    def engine_done(self, ok, err):
        self.installing = False
        self.done = True
        if not ok:
            self.fin_title.set_text("Installation failed")
            self.fin_text.set_text((err or "Unknown error.") + "\nSee the details on the previous page.")
            self.btn_reboot.hide()
        self.set_page_complete(self.p_progress, True)
        self.next_page()
        return False

    def on_cancel(self, *_):
        if self.installing:
            return
        Gtk.main_quit()


def main():
    prov = Gtk.CssProvider()
    prov.load_from_data(CSS)
    from gi.repository import Gdk
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    w = Installer()
    w.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
