            info = run(["upower", "-i", p])
            pct = re.search(r"percentage:\s*(\S+)", info)
            state = re.search(r"state:\s*(\S+)", info)
            left = re.search(r"time to (empty|full):\s*(.+)", info)
            sub = (state.group(1).replace("-", " ").capitalize() if state else "")
            if left:
                sub += f" · {left.group(2).strip()} to {left.group(1)}"
            r = Adw.ActionRow(title=pct.group(1) if pct else "Battery", subtitle=sub)
            r.add_prefix(Gtk.Image.new_from_icon_name("battery-good-symbolic"))
            gb.add(r)
        if bats:
            page.add(gb)

        gp = Adw.PreferencesGroup(title="Power mode",
                                  description="Balanced suits most people; Power saver makes the battery last longer")
        profiles = [l.strip(" *:") for l in run(["powerprofilesctl", "list"]).splitlines()
                    if re.match(r"^\s*\*?\s*[a-z-]+:$", l)]
        cur = run(["powerprofilesctl", "get"]).strip()
        names = {"power-saver": ("Power saver", "Less noise and heat, longer battery"),
                 "balanced": ("Balanced", "Good performance with sensible power use"),
                 "performance": ("Performance", "Maximum speed, more power use")}
        first = None
        for p in ["performance", "balanced", "power-saver"]:
            if p not in profiles:
                continue
            title, sub = names[p]
            r = Adw.ActionRow(title=title, subtitle=sub, activatable=True)
            ck = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first:
                ck.set_group(first)
            first = first or ck
            ck.set_active(p == cur)
            ck.connect("toggled", lambda c, pp=p: c.get_active() and run(["powerprofilesctl", "set", pp]))
            r.add_prefix(ck)
            r.set_activatable_widget(ck)
            gp.add(r)
        if not profiles:
            gp.add(Adw.ActionRow(title="Power modes not available", subtitle="power-profiles-daemon is not running"))
        page.add(gp)

        # brilho do ecrã (portáteis): brightnessctl fala com o logind
        dev = run(["brightnessctl", "-m", "-c", "backlight", "info"]).strip().split(",")
        if len(dev) >= 5 and dev[0]:
            gl = Adw.PreferencesGroup(title="Screen")
            row = Adw.ActionRow(title="Brightness")
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 100, 1)
            sc.set_hexpand(True)
            sc.set_size_request(280, -1)
            sc.set_valign(Gtk.Align.CENTER)
            try:
                sc.set_value(float(dev[3].rstrip("%")))
            except ValueError:
                pass
            sc.connect("value-changed", lambda s: run(["brightnessctl", "-q", "-c", "backlight", "set",
                                                       f"{int(s.get_value())}%"]))
            row.add_suffix(sc)
            gl.add(row)
            page.add(gl)

        # bloqueio quando o PC fica parado (nexora-idle + swayidle; não bloqueia a meio de jogos/vídeos)
        gi = Adw.PreferencesGroup(title="When idle",
                                  description="Never happens while a game or a video is playing")
        try:
            lock, off = (int(x) for x in read_conf("idle", "300 600").split()[:2])
        except ValueError:
            lock, off = 300, 600
        times = [0, 60, 120, 300, 600, 900, 1800]
        labels = ["Never", "1 minute", "2 minutes", "5 minutes", "10 minutes", "15 minutes", "30 minutes"]
        self.idle_rows = {}
        for key, title, val in (("lock", "Lock the screen after", lock), ("off", "Turn the screen off after", off)):
            r = Adw.ComboRow(title=title, model=Gtk.StringList.new(labels))
