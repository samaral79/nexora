        self.bt_near = Adw.PreferencesGroup(title="Other devices",
                                            description="Put the device in pairing mode, then search")
        self.bt_scan_btn = Gtk.Button(label="Search", valign=Gtk.Align.CENTER, css_classes=["flat"])
        self.bt_scan_btn.connect("clicked", lambda *_: self.bt_scan())
        self.bt_near.set_header_suffix(self.bt_scan_btn)
        page.add(self.bt_near)
        self.bt_rows = []
        self.bt_sw_handler = self.bt_sw.connect("notify::active", self.bt_power)
        self.bt_refresh()
        return page

    def bt_info(self):
        """(tem adaptador, ligado, [(mac, nome, emparelhado, ligado, ícone)])"""
        show = run(["bluetoothctl", "show"], 4)
        if "Controller" not in show:
            return False, False, []
        powered = "Powered: yes" in show
        devs = []
        for line in run(["bluetoothctl", "devices"], 4).splitlines():
            m = re.match(r"Device ([0-9A-F:]{17}) (.*)", line)
            if not m:
                continue
            mac, name = m.groups()
            info = run(["bluetoothctl", "info", mac], 4)
            icon = re.search(r"Icon: (\S+)", info)
            devs.append((mac, name, "Paired: yes" in info, "Connected: yes" in info,
                         (icon.group(1) if icon else "bluetooth") + "-symbolic"))
        return True, powered, devs

    def bt_refresh(self):
        threading.Thread(target=lambda: GLib.idle_add(self.bt_fill, *self.bt_info()), daemon=True).start()

    def bt_fill(self, has, powered, devs):
        for g, r in self.bt_rows:
            g.remove(r)
        self.bt_rows = []
        self.bt_sw.handler_block(self.bt_sw_handler)
        self.bt_sw.set_active(powered)
        self.bt_sw.handler_unblock(self.bt_sw_handler)
        self.bt_sw.set_sensitive(has)
        self.bt_scan_btn.set_sensitive(has and powered)
        self.bt_status.set_subtitle("No Bluetooth adapter found" if not has else
                                    "On — visible as this computer" if powered else "Off")
        self.bt_paired.set_visible(has and powered)
        self.bt_near.set_visible(has and powered)
        for mac, name, paired, conn, icon in devs:
            g = self.bt_paired if paired else self.bt_near
            row = Adw.ActionRow(title=name, subtitle=("Connected" if conn else "Not connected") if paired else mac)
            row.add_prefix(Gtk.Image.new_from_icon_name(icon))
            if paired:
                b = Gtk.Button(label="Disconnect" if conn else "Connect", valign=Gtk.Align.CENTER)
                b.connect("clicked", lambda _b, m=mac, c=conn: self.bt_do(["disconnect" if c else "connect", m],
                                                                       "Disconnected" if c else "Connected"))
                row.add_suffix(b)
                rm = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                                tooltip_text="Forget device")
                rm.connect("clicked", lambda _b, m=mac: self.bt_do(["remove", m], "Device removed"))
                row.add_suffix(rm)
            else:
                row.set_activatable(True)
                row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
                row.connect("activated", lambda _r, m=mac, n=name: self.bt_pair(m, n))
            g.add(row)
            self.bt_rows.append((g, row))
        return False

    def bt_power(self, sw, _p):
        self.bt_do(["power", "on" if sw.get_active() else "off"], None)

    def bt_do(self, args, ok_msg, timeout=20):
        def work():
            out = run(["bluetoothctl", "--timeout", str(timeout)] + args, timeout + 5)
            good = "succeeded" in out or "Successful" in out or "Changing" in out or "removed" in out
            if ok_msg:
                GLib.idle_add(self.toast, ok_msg if good else "Didn't work — try again")
            GLib.idle_add(self.bt_refresh)
        threading.Thread(target=work, daemon=True).start()

    def bt_scan(self):
        self.toast("Searching for devices…")
        self.bt_scan_btn.set_sensitive(False)

        def work():
            run(["bluetoothctl", "--timeout", "12", "scan", "on"], 20)
            GLib.idle_add(self.bt_refresh)
        threading.Thread(target=work, daemon=True).start()

    def bt_pair(self, mac, name):
        self.toast(f"Pairing with {name}…")

        def work():
            out = run(["bluetoothctl", "--timeout", "25", "pair", mac], 30)
            ok = "Pairing successful" in out or "AlreadyExists" in out
            if ok:
                run(["bluetoothctl", "trust", mac], 6)
                run(["bluetoothctl", "--timeout", "15", "connect", mac], 20)
            GLib.idle_add(self.toast, f"{name} is ready" if ok else f"Couldn't pair with {name}")
            GLib.idle_add(self.bt_refresh)
        threading.Thread(target=work, daemon=True).start()

