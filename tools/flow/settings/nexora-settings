def gpu_summary():
    """Placas gráficas e o driver que cada uma está a usar (amdgpu, i915/xe, nvidia, nouveau...)."""
    vendors = {"0x1002": "AMD", "0x8086": "Intel", "0x10de": "NVIDIA", "0x1af4": "Virtual machine"}
    out = []
    for card in sorted(os.listdir("/sys/class/drm")):
        if not re.fullmatch(r"card\d+", card):
            continue
        dev = f"/sys/class/drm/{card}/device"
        try:
            vendor = open(f"{dev}/vendor").read().strip()
            driver = os.path.basename(os.readlink(f"{dev}/driver"))
        except OSError:
            continue
        if driver == "nvidia":
            try:
                driver += " " + open("/sys/module/nvidia/version").read().strip()
            except OSError:
                pass
        elif driver == "nouveau":
            driver += " + NVK"
        elif driver == "virtio-pci":
            driver = "virtio-gpu"
        out.append(f"{vendors.get(vendor, 'GPU')} · {driver}")
    return ", ".join(out) or "No GPU driver loaded"


class Settings(Adw.ApplicationWindow):
