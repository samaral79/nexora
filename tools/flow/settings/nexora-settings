    def refresh_sound(self):
        out = run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        m = re.search(r"Volume:\s*([\d.]+)", out)
        if m:
            self.vol.set_value(float(m.group(1)) * 100)
        self.mute.set_active("MUTED" in out)
        sinks, self.sink_ids, cur = [], [], 0
        sec = False
        for line in run(["wpctl", "status"]).splitlines():
            if "Sinks:" in line:
                sec = True
                continue
            if sec:
                mm = re.match(r"[\s│├└─]*(\*)?\s*(\d+)\.\s+(.+?)(\s+\[vol:.*)?$", line)
                if not mm:
                    if line.strip(" │") == "" or ":" in line:
                        sec = False
                    continue
                if mm.group(1):
                    cur = len(sinks)
                sinks.append(mm.group(3).strip())
                self.sink_ids.append(mm.group(2))
        self.sinks_row.set_model(Gtk.StringList.new(sinks or ["No output devices"]))
        self.sinks_row.set_selected(cur)
        self.sinks_row.connect("notify::selected", lambda r, _p: self.sink_ids and run(
            ["wpctl", "set-default", self.sink_ids[r.get_selected()]]))

