        items = (("Kernel", f"{os.uname().release} · scheduler {sched}"),
                 ("Graphics", gpu_summary()),
                 ("NTSYNC", "Ready — faster Windows games in Proton/Wine" if os.path.exists("/dev/ntsync")
                  else "Not available"),
                 ("GameMode", "Ready — boosts the CPU while you play" if shutil.which("gamemoded")
