    def page_keyboard(self):
        page = self.prefs_page()
        g = Adw.PreferencesGroup(title="Keyboard layout",
                                 description="Used by Nexora Flow. The login screen and Xfce keep the layout chosen at install.")
        cur = niri_block_get().get("layout") or self.current_layout()
        row = Adw.ComboRow(title="Layout", model=Gtk.StringList.new([k[0] for k in KEYMAPS]))
        row.set_selected(next((i for i, k in enumerate(KEYMAPS) if k[1] == cur), 0))
        row.connect("notify::selected", lambda r, _p: (niri_update(layout=KEYMAPS[r.get_selected()][1]),
                                                       self.toast("Keyboard layout changed")))
        g.add(row)
        page.add(g)
        g2 = Adw.PreferencesGroup(title="Shortcuts")
        for keys, what in (("Super + Space", "Apps"), ("Super + Return", "Terminal"), ("Super + E", "Files"),
                           ("Super + B", "Firefox"), ("Super + O", "Overview"), ("Super + Q", "Close window"),
                           ("Super + ← / →", "Move along the strip"), ("Super + 1…5", "Workspaces"),
                           ("Super + Shift + /", "All shortcuts")):
            r = Adw.ActionRow(title=what)
            r.add_suffix(Gtk.Label(label=keys, css_classes=["dim-label"]))
            g2.add(r)
        page.add(g2)
