        ("net.davidotek.pupgui2", "ProtonUp-Qt", "Install Proton-GE and other compatibility tools"),
    ]
    LAYERS = [  # camadas Vulkan para as apps Flatpak (ramo = o do runtime do Steam)
        ("org.freedesktop.Platform.VulkanLayer.MangoHud", "MangoHud", "FPS and performance overlay"),
        ("org.freedesktop.Platform.VulkanLayer.gamescope", "Gamescope", "Valve's game compositor (upscaling, frame limit)"),
    ]

    def page_gaming(self):
        page = self.prefs_page()
        self.game_rows = {}
        ga = Adw.PreferencesGroup(title="Game launchers", description="Installed from Flathub; they keep themselves up to date")
        for app_id, name, desc in self.GAMES:
            r = Adw.ActionRow(title=name, subtitle=desc)
            b = Gtk.Button(valign=Gtk.Align.CENTER)
            r.add_suffix(b)
            ga.add(r)
            self.game_rows[app_id] = (b, name, "app")
