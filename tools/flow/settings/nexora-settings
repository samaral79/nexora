def run(cmd, timeout=6):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:  # noqa: BLE001
        return ""


def in_niri():
    return bool(os.environ.get("NIRI_SOCKET"))


def read_conf(name, default=""):
    try:
        with open(os.path.join(CONF, name)) as f:
            return f.read().strip()
    except OSError:
        return default


def write_conf(name, value):
    os.makedirs(CONF, exist_ok=True)
    with open(os.path.join(CONF, name), "w") as f:
        f.write(value + "\n")


# ------------------------------------------------------------------ bloco gerido no niri
def niri_block_get():
    try:
        with open(NIRI_USER) as f:
            txt = f.read()
    except OSError:
        return {}
    m = re.search(re.escape(BEGIN) + r"\n// (\{.*\})\n", txt)
    return json.loads(m.group(1)) if m else {}


def niri_block_set(state):
    """Reescreve o bloco gerido (saídas, teclado, anel de foco) no config do utilizador."""
    os.makedirs(os.path.dirname(NIRI_USER), exist_ok=True)
    if not os.path.exists(NIRI_USER):
        shutil.copy(NIRI_SYS, NIRI_USER)
    with open(NIRI_USER) as f:
        txt = f.read()
    txt = re.sub(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", "", txt, flags=re.S)
    if "layout" in state:
        txt = re.sub(r'(\n\s*layout )"[a-z]+"', r'\1"%s"' % state["layout"], txt, count=1)
    if "ring" in state:
        a, b = state["ring"]
        txt = re.sub(r'active-gradient from="#[0-9a-fA-F]+" to="#[0-9a-fA-F]+"',
                     f'active-gradient from="{a}" to="{b}"', txt, count=1)
    lines = [BEGIN, "// " + json.dumps(state)]
    for name, o in sorted(state.get("outputs", {}).items()):
        lines.append(f'output "{name}" {{')
        if o.get("off"):
            lines.append("    off")
        if o.get("mode"):
            lines.append(f'    mode "{o["mode"]}"')
        if o.get("scale"):
            lines.append(f'    scale {o["scale"]}')
        lines.append("}")
    lines.append(END)
    with open(NIRI_USER, "w") as f:
        f.write(txt.rstrip("\n") + "\n\n" + "\n".join(lines) + "\n")


def niri_update(**kw):
    st = niri_block_get()
    for k, v in kw.items():
        if k == "outputs":
            st.setdefault("outputs", {}).update(v)
        else:
            st[k] = v
    niri_block_set(st)


