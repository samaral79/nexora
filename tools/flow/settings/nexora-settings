            r.add_suffix(b)
            gl.add(r)
            self.game_rows[ref] = (b, name, "layer")
        self.mango = Adw.SwitchRow(title="Performance overlay in every Steam game",
                                   subtitle="Turns on MangoHud for Steam (Shift+F12 hides it)")
