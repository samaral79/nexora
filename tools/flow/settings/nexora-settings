    def scan_wifi(self):
        def work():
            out = run(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"], timeout=15)
            GLib.idle_add(self.fill_wifi, out)
        threading.Thread(target=work, daemon=True).start()

    def fill_wifi(self, out):
        for r in self.net_rows:
            self.net_group.remove(r)
        self.net_rows = []
        seen = set()
        for line in out.splitlines():
            parts = re.split(r"(?<!\\):", line)
            if len(parts) < 4 or not parts[1] or parts[1] in seen:
                continue
            seen.add(parts[1])
            inuse, ssid, sig, sec = parts[0] == "*", parts[1].replace("\\:", ":"), int(parts[2] or 0), parts[3]
            row = Adw.ActionRow(title=ssid, subtitle=("Connected · " if inuse else "") + (sec or "Open"),
                                activatable=not inuse)
            icon = "network-wireless-signal-" + ("excellent" if sig > 75 else "good" if sig > 50
                                                 else "ok" if sig > 25 else "weak") + "-symbolic"
            row.add_prefix(Gtk.Image.new_from_icon_name(icon))
            if not inuse:
                row.connect("activated", self.connect_wifi, ssid, bool(sec))
            self.net_group.add(row)
            self.net_rows.append(row)
        if not self.net_rows:
            row = Adw.ActionRow(title="No Wi-Fi networks found")
            self.net_group.add(row)
            self.net_rows.append(row)
        return False

    def connect_wifi(self, _row, ssid, secured):
        if not secured:
            threading.Thread(target=lambda: (run(["nmcli", "dev", "wifi", "connect", ssid], 40),
                                             GLib.idle_add(self.scan_wifi)), daemon=True).start()
            return
        dlg = Adw.AlertDialog(heading=f"Connect to “{ssid}”", body="Enter the network password")
        entry = Gtk.PasswordEntry(show_peek_icon=True)
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("connect", "Connect")
        dlg.set_response_appearance("connect", Adw.ResponseAppearance.SUGGESTED)

        def resp(_d, r):
            if r == "connect":
                pw = entry.get_text()
                self.toast(f"Connecting to {ssid}…")

                def work():
                    out = run(["nmcli", "dev", "wifi", "connect", ssid, "password", pw], 40)
                    GLib.idle_add(self.toast, "Connected" if "successfully" in out else "Could not connect")
                    GLib.idle_add(self.scan_wifi)
                threading.Thread(target=work, daemon=True).start()
        dlg.connect("response", resp)
        dlg.present(self)

