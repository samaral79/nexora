    def pm_refresh(self):
        self.pm_check.set_sensitive(False)
        self.pm_btn.set_visible(False)
        self.pm_status.set_title("Checking for updates…")
        self.pm_status.set_subtitle("")

        def work():
            try:   # checkupdates: 0 = há atualizações, 2 = nenhuma, outro = erro
                p = subprocess.run(["checkupdates"], capture_output=True, text=True, timeout=180)
                rc, out = p.returncode, p.stdout
            except Exception:  # noqa: BLE001
                rc, out = 1, ""
            pkgs = [l.split()[0] for l in out.splitlines() if l.strip()]
            GLib.idle_add(self.pm_show, rc, pkgs)
        threading.Thread(target=work, daemon=True).start()

    def pm_show(self, rc, pkgs):
        self.pm_check.set_sensitive(True)
        for r in getattr(self, "pm_rows", []):
            self.pm_list.remove(r)
        self.pm_rows = []
        if rc == 0 and pkgs:
            self.pm_status.set_title(f"{len(pkgs)} updates available")
            self.pm_status.set_subtitle("A snapshot is taken first, so you can go back")
            self.pm_btn.set_visible(True)
            self.pm_list.set_visible(True)
            for name in pkgs[:200]:
                r = Adw.ActionRow(title=name)
                self.pm_list.add_row(r)
                self.pm_rows.append(r)
        elif rc == 2 or (rc == 0 and not pkgs):
            self.pm_status.set_title("Nexora is up to date")
            self.pm_list.set_visible(False)
        else:
            self.pm_status.set_title("Couldn't check for updates")
            self.pm_status.set_subtitle("Check your internet connection and try again")
            self.pm_list.set_visible(False)
        return False

    def pm_update(self, *_):
        self.pm_btn.set_sensitive(False)
        self.pm_check.set_sensitive(False)
        self.pm_status.set_title("Updating…")
        self.pm_status.set_subtitle("You can keep using the computer")

        def work():
            p = subprocess.run(["pkexec", "pacman", "-Syu", "--noconfirm"], capture_output=True, text=True)
            out = p.stdout + p.stderr
            reboot = re.search(r"\b(linux-cachyos\S*|nvidia\S*|mesa|systemd)\b", out) is not None
            GLib.idle_add(self.pm_done, p.returncode == 0, reboot, out)
        threading.Thread(target=work, daemon=True).start()

    def pm_done(self, ok, reboot, out):
        self.pm_btn.set_sensitive(True)
        if ok:
            self.toast("Restart to finish the update" if reboot else "Nexora is up to date")
        else:
            last = [l for l in out.splitlines() if l.strip()][-1:] or ["unknown error"]
            self.toast("The update didn't finish: " + last[0][:120])
        self.pm_refresh()
        return False

