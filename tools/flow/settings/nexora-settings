                                         "updates work on a Nexora installed from the ISO")
            self.upd_check_btn.set_visible(False)
        else:
            self.upd_refresh(online=True)
        return page

    def upd_versions(self):
        """versões instaladas (offline): [(versão, estado)]"""
        out = run(["updatectl", "--no-pager", "--no-legend", "--offline", "list", "host"], 30)
        res = []
        for line in out.splitlines():
            parts = line.replace("●", " ").split()
            if len(parts) >= 2 and re.match(r"^[0-9][0-9.]*$", parts[0]):
                res.append((parts[0], " ".join(parts[1:])))
        return res

    def upd_refresh(self, online):
        self.upd_check_btn.set_sensitive(False)
        if online:
            self.upd_status.set_title("Checking for updates…")
            self.upd_status.set_subtitle("")

        def work():
            pending = [v for v, st in self.upd_versions()
                       if self.vkey(v) > self.vkey(self.upd_cur)]
            avail = None
            if online:
                try:   # o "No updates available." vai para o stderr
                    p = subprocess.run(["updatectl", "--no-ask-password", "--no-pager", "check"],
                                       capture_output=True, text=True, timeout=120)
                    out = p.stdout + p.stderr
                except Exception:  # noqa: BLE001
                    out = ""
                m = re.search(r"→\s*([0-9][0-9.]*)", out)
                avail = m.group(1) if m else ("" if "No updates" in out else None)
            GLib.idle_add(self.upd_show, max(pending, key=self.vkey) if pending else None, avail)
        threading.Thread(target=work, daemon=True).start()

    def upd_show(self, pending, avail):
        self.upd_check_btn.set_sensitive(True)
        self.upd_btn.set_visible(False)
        self.upd_mode = None
        if pending:
            self.upd_status.set_title(f"Version {pending} is ready")
            self.upd_status.set_subtitle("It starts the next time you turn on the computer")
            self.upd_btn.set_label("Restart now")
            self.upd_mode = "reboot"
            self.upd_btn.set_visible(True)
        elif avail:
            self.upd_status.set_title(f"Version {avail} is available")
            self.upd_status.set_subtitle("Download it now, or let it download by itself in the background")
            self.upd_btn.set_label("Download")
            self.upd_mode = "update"
            self.upd_btn.set_visible(True)
        elif avail == "":
            self.upd_status.set_title("Nexora is up to date")
            self.upd_status.set_subtitle("")
        elif avail is None and self.upd_status.get_title().startswith("Checking for"):
            self.upd_status.set_title("Couldn't check for updates")
            self.upd_status.set_subtitle("Check your internet connection and try again")
        else:
            self.upd_status.set_title("Up to date as of the last check")
            self.upd_status.set_subtitle("Use the refresh button to check now")
        return False

    def upd_action(self, *_):
        if self.upd_mode == "reboot":
            subprocess.Popen(["systemctl", "reboot"])
            return
        self.upd_btn.set_sensitive(False)
        self.upd_check_btn.set_sensitive(False)
        self.upd_status.set_title("Downloading the new version…")
        self.upd_status.set_subtitle("You can keep using the computer")

        def work():
            p = subprocess.run(["updatectl", "--no-ask-password", "--no-pager", "update"],
                               capture_output=True, text=True)
            GLib.idle_add(self.upd_done, p.returncode == 0)
        threading.Thread(target=work, daemon=True).start()

    def upd_done(self, ok):
        self.upd_btn.set_sensitive(True)
        if not ok:
            self.toast("The update didn't finish — it will try again by itself later")
        self.upd_refresh(online=False)
        return False

