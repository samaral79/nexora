    def flatpak_branch(self):
        """Ramo do runtime do Steam (as camadas Vulkan têm de ser do mesmo)."""
        out = run(["flatpak", "info", "--show-runtime", "com.valvesoftware.Steam"])
        return out.strip().rsplit("/", 1)[-1] if out.strip() else ""

    def game_refresh(self):
        def work():
            have = set(run(["flatpak", "list", "--columns=application"], 15).split())
            mango = "MANGOHUD=1" in run(["flatpak", "override", "--user", "--show", "com.valvesoftware.Steam"])
            GLib.idle_add(self.game_fill, have, mango)
        threading.Thread(target=work, daemon=True).start()

    def game_fill(self, have, mango):
        steam = "com.valvesoftware.Steam" in have
        for ref, (b, name, kind) in self.game_rows.items():
            try:
                b.disconnect(b.handler)
            except (AttributeError, TypeError):
                pass
            inst = ref in have
            if kind == "app":
                b.set_label("Open" if inst else "Install")
                b.set_css_classes([] if inst else ["suggested-action"])
                b.handler = b.connect("clicked", lambda _b, r=ref, i=inst, n=name:
                                      subprocess.Popen(["flatpak", "run", r]) if i else self.game_install(r, n, "app"))
                b.set_sensitive(True)
            else:
                b.set_label("Installed" if inst else "Install")
                b.set_css_classes([] if inst else ["suggested-action"])
                b.set_sensitive(not inst and steam)
                b.set_tooltip_text(None if steam else "Install Steam first")
                b.handler = b.connect("clicked", lambda _b, r=ref, n=name: self.game_install(r, n, "layer"))
        try:
            self.mango.disconnect(self.mango.handler)
        except (AttributeError, TypeError):
            pass
        self.mango.set_active(mango)
        self.mango.set_sensitive(steam and "org.freedesktop.Platform.VulkanLayer.MangoHud" in have)
        self.mango.handler = self.mango.connect("notify::active", self.game_mango)
        return False

    def game_install(self, ref, name, kind):
        self.toast(f"Installing {name}… (this can take a few minutes)")
        for b, n, _k in self.game_rows.values():
            if n == name:
                b.set_sensitive(False)
                b.set_label("Installing…")

        def work():
            if kind == "layer":
                br = self.flatpak_branch()
                target = [f"runtime/{ref}/x86_64/{br}"] if br else [ref]
            else:
                target = [ref]
            r = subprocess.run(["flatpak", "install", "--system", "-y", "--noninteractive", "flathub"] + target,
                               capture_output=True, text=True)
            GLib.idle_add(self.toast, f"{name} is installed" if r.returncode == 0 else f"Couldn't install {name}")
            GLib.idle_add(self.game_refresh)
        threading.Thread(target=work, daemon=True).start()

    def game_mango(self, sw, _p):
        if sw.get_active():
            run(["flatpak", "override", "--user", "--env=MANGOHUD=1", "com.valvesoftware.Steam"])
        else:
            run(["flatpak", "override", "--user", "--unset-env=MANGOHUD", "com.valvesoftware.Steam"])

