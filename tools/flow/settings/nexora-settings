    def pr_list(self):
        """[(nome, estado, é a predefinida)]"""
        default = run(["lpstat", "-d"]).partition(":")[2].strip()
        states = {}
        for line in run(["lpstat", "-p"]).splitlines():
            m = re.match(r"printer (\S+) (?:is )?(.*?)\.", line)
            if m:
                states[m.group(1)] = m.group(2)
        names = [n for n in run(["lpstat", "-e"]).split() if n]
        return [(n, states.get(n, "ready"), n == default) for n in names]

    def pr_refresh(self):
        threading.Thread(target=lambda: GLib.idle_add(self.pr_fill, self.pr_list()), daemon=True).start()

    def pr_fill(self, printers):
        for r in self.pr_rows:
            self.pr_group.remove(r)
        self.pr_rows = []
        for name, state, default in printers:
            row = Adw.ActionRow(title=name.replace("_", " "),
                                subtitle=("Default · " if default else "") + state.capitalize())
            row.add_prefix(Gtk.Image.new_from_icon_name("printer-symbolic"))
            tp = Gtk.Button(label="Test page", valign=Gtk.Align.CENTER)
            tp.connect("clicked", lambda _b, n=name: self.pr_do(
                ["lp", "-d", n, "/usr/share/cups/data/testprint"], "Test page sent"))
            row.add_suffix(tp)
            if not default:
                df = Gtk.Button(icon_name="emblem-default-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                                tooltip_text="Make default")
                df.connect("clicked", lambda _b, n=name: self.pr_do(["lpoptions", "-d", n], "Default printer set"))
                row.add_suffix(df)
            rm = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                            tooltip_text="Remove printer")
            rm.connect("clicked", lambda _b, n=name: self.pr_do(["lpadmin", "-x", n], "Printer removed"))
            row.add_suffix(rm)
            self.pr_group.add(row)
            self.pr_rows.append(row)
        if not printers:
            row = Adw.ActionRow(title="No printers yet", subtitle="Search below to add one")
            self.pr_group.add(row)
            self.pr_rows.append(row)
        return False

    def pr_do(self, cmd, ok_msg):
        def work():
            try:
                p = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
                ok = p.returncode == 0
            except Exception:  # noqa: BLE001
                ok = False
            GLib.idle_add(self.toast, ok_msg if ok else "Didn't work — try the advanced settings")
            GLib.idle_add(self.pr_refresh)
        threading.Thread(target=work, daemon=True).start()

    def pr_scan(self):
        self.toast("Looking for printers…")
        self.pr_scan_btn.set_sensitive(False)

        def work():
            out = run(["lpinfo", "--timeout", "8", "--include-schemes", "usb,dnssd,ipp,ipps", "-l", "-v"], 25)
            found, cur = [], {}
            for line in out.splitlines():
                line = line.strip()
                if line.startswith("Device: uri = "):
                    if cur:
                        found.append(cur)
                    cur = {"uri": line.split("=", 1)[1].strip()}
                elif "=" in line and cur:
                    k, v = (x.strip() for x in line.split("=", 1))
                    cur[k] = v
            if cur:
                found.append(cur)
            found = [f for f in found if "://" in f["uri"]]
            GLib.idle_add(self.pr_fill_found, found)
        threading.Thread(target=work, daemon=True).start()

    def pr_fill_found(self, found):
        self.pr_scan_btn.set_sensitive(True)
        for r in self.pr_found_rows:
            self.pr_found.remove(r)
        self.pr_found_rows = []
        for f in found:
            title = f.get("info") or f.get("make-and-model") or f["uri"]
            how = "USB" if f["uri"].startswith("usb:") else "Network"
            row = Adw.ActionRow(title=title, subtitle=f"{how} · {f.get('make-and-model', '')}".rstrip(" ·"),
                                activatable=True)
            row.add_prefix(Gtk.Image.new_from_icon_name("printer-symbolic"))
            row.add_suffix(Gtk.Image.new_from_icon_name("list-add-symbolic"))
            row.connect("activated", lambda _r, ff=f, t=title: self.pr_add(ff, t))
            self.pr_found.add(row)
            self.pr_found_rows.append(row)
        if not found:
            row = Adw.ActionRow(title="No printers found", subtitle="Check that it is on and connected")
            self.pr_found.add(row)
            self.pr_found_rows.append(row)
        return False

    def pr_add(self, f, title):
        # driverless (IPP Everywhere / AirPrint): serve para quase todas as impressoras dos últimos 10 anos
        name = re.sub(r"[^A-Za-z0-9_-]+", "_", title).strip("_")[:120] or "Printer"
        self.toast(f"Adding {title}…")
        self.pr_do(["lpadmin", "-p", name, "-E", "-v", f["uri"], "-m", "everywhere"], f"{title} is ready")


    # -------------------------------------------------------------- Jogos (Flatpak + GameMode + kernel)
