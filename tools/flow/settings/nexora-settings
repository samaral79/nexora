                    cur = line.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
        self.upd_cur = cur
        ab = os.path.isdir("/var/lib/nexora/etc")
        g = Adw.PreferencesGroup(title="Nexora")
        self.upd_ver = Adw.ActionRow(title="Version " + (cur or "unknown"))
        self.upd_ver.add_prefix(Gtk.Image.new_from_icon_name("emblem-system-symbolic"))
        g.add(self.upd_ver)
        self.upd_status = Adw.ActionRow(title="Checking…")
        self.upd_btn = Gtk.Button(valign=Gtk.Align.CENTER, visible=False, css_classes=["suggested-action"])
        self.upd_btn.connect("clicked", self.upd_action)
        self.upd_status.add_suffix(self.upd_btn)
        self.upd_check_btn = Gtk.Button(icon_name="view-refresh-symbolic", valign=Gtk.Align.CENTER,
                                        css_classes=["flat"], tooltip_text="Check for updates")
        self.upd_check_btn.connect("clicked", lambda *_: self.upd_refresh(online=True))
        self.upd_status.add_suffix(self.upd_check_btn)
        g.add(self.upd_status)
        page.add(g)
        gi = Adw.PreferencesGroup(title="How updates work")
        for icon, title, sub in (
                ("folder-download-symbolic", "In the background",
                 "New versions download by themselves and are written next to the one you are using"),
                ("system-reboot-symbolic", "On the next start",
                 "Nothing changes while you work: the new version starts the next time you turn on the computer"),
                ("edit-undo-symbolic", "Safe",
                 "If a new version fails to start 3 times, the previous one comes back by itself"),
                ("user-home-symbolic", "Your things stay",
                 "Your files, settings, apps from Flathub and the AUR are kept across versions")):
            r = Adw.ActionRow(title=title, subtitle=sub)
            r.add_prefix(Gtk.Image.new_from_icon_name(icon))
            gi.add(r)
        page.add(gi)
