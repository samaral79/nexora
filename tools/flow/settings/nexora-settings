    def current_layout(self):
        for p in (NIRI_USER, NIRI_SYS):
            try:
                m = re.search(r'\n\s*layout "([a-z]+)"', open(p).read())
                if m:
                    return m.group(1)
            except OSError:
                pass
        return "pt"

    # -------------------------------------------------------------- Acerca
    def page_about(self):
        page = self.prefs_page()
        g = Adw.PreferencesGroup()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_bottom=12)
        logo = Gtk.Image.new_from_icon_name("nexora")
        logo.set_pixel_size(96)
        box.append(logo)
        box.append(Gtk.Label(label="Nexora Linux", css_classes=["title-1"]))
        ver = "13.1"
        try:
            for line in open("/etc/os-release"):
                if line.startswith("VERSION="):
                    ver = line.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
        box.append(Gtk.Label(label=f"Version {ver}", css_classes=["dim-label"]))
        g.add(box)
        page.add(g)
        g2 = Adw.PreferencesGroup(title="System")
        cpu = ""
        try:
            cpu = next(l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name"))
        except (OSError, StopIteration):
            pass
        mem = 0
        try:
            mem = int(next(l.split()[1] for l in open("/proc/meminfo") if l.startswith("MemTotal"))) / 1024 / 1024
        except (OSError, StopIteration):
            pass
        st = os.statvfs("/")
        disk = st.f_blocks * st.f_frsize / 1e9
        free = st.f_bavail * st.f_frsize / 1e9
        gpu = ""
        for l in run(["glxinfo", "-B"]).splitlines():
            if "Device:" in l or "OpenGL renderer string" in l:
                gpu = l.split(":", 1)[1].strip()
                break
        for title, val in (("Processor", cpu or "—"), ("Memory", f"{mem:.1f} GB"), ("Graphics", gpu or "—"),
                           ("Disk", f"{free:.0f} GB free of {disk:.0f} GB"),
                           ("Kernel", os.uname().release),
                           ("Session", "Nexora Flow (niri)" if in_niri() else os.environ.get("XDG_CURRENT_DESKTOP", "—"))):
            r = Adw.ActionRow(title=title, subtitle=val)
            r.set_subtitle_selectable(True)
            g2.add(r)
        page.add(g2)
        return page


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.page = None

    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        self.page = args[0] if args else None
        self.activate()
        return 0

    def do_activate(self):
        win = self.props.active_window or Settings(self)
        if self.page and self.page in win.rows:
            win.lb.select_row(win.row_widgets[self.page])
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
