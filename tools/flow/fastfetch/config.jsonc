// fastfetch da Nexora (copia para ~/.config/fastfetch/config.jsonc para mudares)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/nexora/fastfetch-logo.txt",
    "type": "file",
    "color": { "1": "cyan", "2": "white" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "cyan" },
    "key": { "width": 14 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "Sistema" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Ligado há" },
    { "type": "packages", "key": "Pacotes" },
    { "type": "shell", "key": "Shell" },
    { "type": "wm", "key": "Ambiente" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "Processador" },
    { "type": "gpu", "key": "Gráfica" },
    { "type": "memory", "key": "Memória" },
    { "type": "swap", "key": "Swap" },
    { "type": "disk", "key": "Disco", "folders": "/" },
    { "type": "battery", "key": "Bateria" },
    "break",
    "colors"
  ]
}
