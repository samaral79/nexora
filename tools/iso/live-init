#!/bin/bash
# /init do initramfs live da Nexora.
# Encontra o meio de arranque pela label, monta o squashfs só-de-leitura com uma camada
# tmpfs por cima (overlayfs) e passa o controlo ao systemd.
#   parâmetros: nexora.label=NEXORA_LIVE (por omissão)   nexora.shell (shell antes de arrancar)
export PATH=/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=755,nosuid,nodev tmpfs /run

LABEL=NEXORA_LIVE
SHELL_FIRST=
for arg in $(cat /proc/cmdline); do
    case $arg in
        nexora.label=*) LABEL=${arg#nexora.label=} ;;
        nexora.shell)   SHELL_FIRST=1 ;;
        quiet)          QUIET=1 ;;
    esac
done
msg() { [ -n "${QUIET:-}" ] || echo "nexora-live: $*"; }

rescue() {
    echo
    echo "nexora-live: ERRO — $*"
    echo "A abrir uma shell de emergência (escreve 'exit' para tentar continuar)."
    /usr/bin/bash
}

msg "à procura do meio com a label $LABEL"
DEV=
for i in $(seq 1 150); do
    DEV=$(blkid -L "$LABEL" 2>/dev/null) && [ -b "$DEV" ] && break
    DEV=
    sleep 0.2
done
[ -n "$DEV" ] || rescue "não encontrei nenhum disco com a label $LABEL"

mkdir -p /run/live/medium /run/live/rootfs /run/live/rw /sysroot
mount -o ro "$DEV" /run/live/medium 2>/dev/null || mount -t iso9660 -o ro "$DEV" /run/live/medium \
    || rescue "não consegui montar $DEV"
SFS=/run/live/medium/nexora/rootfs.sfs
[ -f "$SFS" ] || rescue "falta $SFS no meio de arranque"
mount -t squashfs -o ro,loop "$SFS" /run/live/rootfs || rescue "não consegui montar o squashfs"
mount -t tmpfs -o mode=755 tmpfs /run/live/rw
mkdir -p /run/live/rw/upper /run/live/rw/work
mount -t overlay overlay \
    -o lowerdir=/run/live/rootfs,upperdir=/run/live/rw/upper,workdir=/run/live/rw/work /sysroot \
    || rescue "não consegui montar o overlay"
msg "sistema live montado a partir de $DEV"

[ -n "$SHELL_FIRST" ] && rescue "shell pedida com nexora.shell"

# o switch_root leva /dev /proc /sys /run para o sistema novo (e com eles o /run/live)
umount /dev/pts 2>/dev/null
exec switch_root /sysroot /usr/lib/systemd/systemd
